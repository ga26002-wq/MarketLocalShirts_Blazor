@page "/admin/marcas"
@inject MarcaService MarcaService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Administración de Marcas - MarketLocalShirts</PageTitle>

<div class="container my-5 text-white">

    @if (!mostrarFormulario)
    {
        <!-- ========================================== -->
        <!--    VISTA 1: TABLA / LISTADO DE MARCAS      -->
        <!-- ========================================== -->
        <div class="d-flex justify-content-between align-items-center mb-5">
            <h1 class="fw-bold display-3 m-0">Marcas</h1>
            <button class="btn btn-info text-white fw-bold px-4 py-3 fs-4 rounded-3" 
                    style="background-color: #00a8ff; border: none; min-width: 180px;" 
                    @onclick="AbrirFormularioNueva">
                Agregar Marca
            </button>
        </div>

        <!-- Encabezados -->
        <div class="row text-white fw-bold fs-4 mb-3 px-3">
            <div class="col-md-6">Nombre</div>
            <div class="col-md-6 text-end pe-5">Acciones</div>
        </div>

        <!-- Listado de Marcas -->
        @if (cargando)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-info" role="status">
                    <span class="visually-hidden">Cargando marcas desde la API...</span>
                </div>
            </div>
        }
        else if (marcas == null || !marcas.Any())
        {
            <div class="text-center py-5 text-white-50 fs-4">
                No hay marcas registradas en la base de datos.
            </div>
        }
        else
        {
            @foreach (var m in marcas)
            {
                <div class="row align-items-center bg-black py-3 mb-3 rounded border border-secondary px-3">
                    <div class="col-md-6">
                        <h3 class="fw-bold m-0 fs-3">@m.Nombre</h3>
                    </div>

                    <div class="col-md-6 d-flex justify-content-end gap-3 pe-4">
                        <button class="btn btn-warning text-dark fw-bold px-4 py-2 fs-4" 
                                style="background-color: #d4af37; border: none; min-width: 130px;"
                                @onclick="() => AbrirFormularioEditar(m)">
                            Editar
                        </button>
                        <button class="btn btn-danger text-white fw-bold px-4 py-2 fs-4" 
                                style="background-color: #ff0000; border: none; min-width: 130px;"
                                @onclick="() => SolicitarConfirmacionEliminar(m)">
                            Eliminar
                        </button>
                    </div>
                </div>
            }
        }
    }
    else
    {
        <!-- ========================================== -->
        <!--  VISTA 2: FORMULARIO CREAR / EDITAR MARCA  -->
        <!-- ========================================== -->
        <div class="d-flex justify-content-between align-items-center mb-5">
            <h1 class="fw-bold display-3 m-0">
                @(marcaEdicion.Id == 0 ? "Nueva Marca" : "Editar Marca")
            </h1>
            <button class="btn btn-info text-white fw-bold px-4 py-3 fs-4 rounded-3" 
                    style="background-color: #00a8ff; border: none; min-width: 160px;" 
                    @onclick="CancelarFormulario">
                Volver
            </button>
        </div>

        <div class="row justify-content-center my-5">
            <div class="col-md-8">
                <div class="mb-4">
                    <label class="form-label fw-bold fs-3">Nombre de la Marca</label>
                    <input type="text" 
                           class="form-control bg-secondary text-white fs-4 p-3 @(errores.ContainsKey("Nombre") ? "border border-danger" : "border-0")" 
                           @bind="marcaEdicion.Nombre" 
                           placeholder="Ej: Adidas, Nike, Puma..." />
                    @if (errores.TryGetValue("Nombre", out var errorNombre))
                    {
                        <div class="text-danger fw-bold mt-1">@errorNombre</div>
                    }
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold fs-3">Descripción (Opcional)</label>
                    <textarea class="form-control bg-secondary text-white fs-4 p-3 @(errores.ContainsKey("Descripcion") ? "border border-danger" : "border-0")" 
                              rows="3" 
                              @bind="marcaEdicion.Descripcion" 
                              placeholder="Descripción breve de la marca"></textarea>
                    @if (errores.TryGetValue("Descripcion", out var errorDescripcion))
                    {
                        <div class="text-danger fw-bold mt-1">@errorDescripcion</div>
                    }
                </div>
            </div>
        </div>

        <!-- Botones Inferiores Centrados -->
        <div class="row mt-5">
            <div class="col-12 d-flex justify-content-center gap-4">
                <button class="btn btn-info text-white fw-bold px-5 py-3 fs-3 rounded-2" 
                        style="background-color: #00a8ff; border: none; min-width: 220px;" 
                        @onclick="GuardarMarca">
                    Guardar
                </button>
                <button class="btn btn-light text-dark fw-bold px-5 py-3 fs-3 rounded-2" 
                        style="min-width: 220px;" 
                        @onclick="CancelarFormulario">
                    Cancelar
                </button>
            </div>
        </div>
    }

    <!-- Mensajes de Feedback -->
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="row mt-4">
            <div class="col-12 text-center">
                <div class="alert alert-info d-inline-block px-4 py-2 fs-5" role="alert">
                    @mensaje
                </div>
            </div>
        </div>
    }

</div>

<!-- MODAL DE CONFIRMACIÓN DE ELIMINACIÓN -->
@if (mostrarModalConfirmacion)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.85);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white border border-secondary p-3">
                <div class="modal-header border-0 pb-0">
                    <h4 class="modal-title fw-bold text-danger">⚠️ Confirmar eliminación</h4>
                    <button type="button" class="btn-close btn-close-white" @onclick="CancelarEliminacion"></button>
                </div>
                <div class="modal-body py-4 fs-4 text-center">
                    ¿Estás seguro de que deseas eliminar la marca <strong class="text-info">"@marcaAEliminar?.Nombre"</strong>?
                    <p class="fs-6 text-white-50 mt-2 m-0">Esta acción no se puede deshacer en la base de datos.</p>
                </div>
                <div class="modal-footer border-0 d-flex justify-content-center gap-3">
                    <button type="button" class="btn btn-danger fw-bold px-4 py-2 fs-5" @onclick="ConfirmarEliminarMarca">
                        Sí, eliminar
                    </button>
                    <button type="button" class="btn btn-secondary fw-bold px-4 py-2 fs-5" @onclick="CancelarEliminacion">
                        Cancelar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<MarcaSalidaDTO> marcas = new();
    private string mensaje = string.Empty;
    private Dictionary<string, string> errores = new();
    private bool cargando = true;
    private bool mostrarFormulario = false;

    private bool mostrarModalConfirmacion = false;
    private MarcaSalidaDTO? marcaAEliminar = null;

    private MarcaSalidaDTO marcaEdicion = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        if (!await AuthService.IsAuthenticated())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await CargarMarcasDesdeApi();
        StateHasChanged();
    }

    private async Task CargarMarcasDesdeApi()
    {
        cargando = true;
        try
        {
            marcas = await MarcaService.ObtenerTodasAsync();
        }
        catch (Exception ex)
        {
            mensaje = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirFormularioNueva()
    {
        marcaEdicion = new MarcaSalidaDTO();
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private void AbrirFormularioEditar(MarcaSalidaDTO m)
    {
        marcaEdicion = new MarcaSalidaDTO
        {
            Id = m.Id,
            Nombre = m.Nombre,
            Descripcion = m.Descripcion
        };
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private void CancelarFormulario()
    {
        mostrarFormulario = false;
        mensaje = string.Empty;
    }

    private async Task GuardarMarca()
    {
        try
        {
            var datos = new MarcaGuardarDTO
            {
                Nombre = marcaEdicion.Nombre,
                Descripcion = marcaEdicion.Descripcion ?? string.Empty
            };
            errores = ValidacionFormulario.Errores(datos);
            if (errores.Count > 0)
            {
                mensaje = "Revisa los campos marcados en rojo.";
                return;
            }

            var resultado = await MarcaService.GuardarAsync(datos, marcaEdicion.Id);

            mensaje = resultado.Mensaje;
            if (resultado.Ok)
            {
                mostrarFormulario = false;
                await CargarMarcasDesdeApi();
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Excepción al guardar la marca: {ex.Message}";
        }
    }

    private void SolicitarConfirmacionEliminar(MarcaSalidaDTO marca)
    {
        marcaAEliminar = marca;
        mostrarModalConfirmacion = true;
    }

    private void CancelarEliminacion()
    {
        marcaAEliminar = null;
        mostrarModalConfirmacion = false;
    }

    private async Task ConfirmarEliminarMarca()
    {
        if (marcaAEliminar == null) return;

        try
        {
            var resultado = await MarcaService.EliminarAsync(marcaAEliminar.Id);
            if (resultado.Ok)
            {
                mensaje = $"La marca '{marcaAEliminar.Nombre}' fue eliminada.";
                marcas.RemoveAll(m => m.Id == marcaAEliminar.Id);
            }
            else
            {
                mensaje = resultado.Mensaje;
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Excepción al eliminar la marca: {ex.Message}";
        }
        finally
        {
            mostrarModalConfirmacion = false;
            marcaAEliminar = null;
            StateHasChanged();
        }
    }

}