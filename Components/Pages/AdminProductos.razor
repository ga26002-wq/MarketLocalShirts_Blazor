@page "/admin/productos"
@inject CamisaService CamisaService
@inject MarcaService MarcaService
@inject CategoriaService CategoriaService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Administración de Productos - MarketLocalShirts</PageTitle>

<div class="container my-5 text-white">

    @if (!mostrarFormulario)
    {
        <!-- ========================================== -->
        <!--    VISTA 1: TABLA / LISTADO DE PRODUCTOS    -->
        <!-- ========================================== -->
        <div class="d-flex justify-content-between align-items-center mb-5">
            <h1 class="fw-bold display-3 m-0">Productos</h1>
            <button class="btn btn-info text-white fw-bold px-4 py-3 fs-4 rounded-3" 
                    style="background-color: #00a8ff; border: none; min-width: 160px;" 
                    @onclick="AbrirFormularioNuevo">
                + Nuevo
            </button>
        </div>

        <!-- Buscador -->
        <div class="row justify-content-center mb-5">
            <div class="col-md-8 d-flex gap-2">
                <input type="text" 
                       class="form-control bg-secondary text-white border-0 fs-5 p-3" 
                       placeholder="Buscar producto por nombre o marca..." 
                       @bind="criterioBusqueda" 
                       @bind:event="oninput" />
                <button class="btn btn-info text-white fw-bold px-4 fs-5" 
                        style="background-color: #00a8ff; border: none; min-width: 140px;"
                        @onclick="FiltrarProductos">
                    Buscar
                </button>
            </div>
        </div>

        <!-- Encabezados -->
        <div class="row text-white fw-bold fs-4 mb-3 px-3">
            <div class="col-md-4">Producto</div>
            <div class="col-md-2 text-center">Marca</div>
            <div class="col-md-2 text-center">Precio</div>
            <div class="col-md-1 text-center">Stock</div>
            <div class="col-md-3 text-center">Acciones</div>
        </div>

        <!-- Listado -->
        @if (cargando)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-info" role="status">
                    <span class="visually-hidden">Cargando productos desde la API...</span>
                </div>
            </div>
        }
        else if (productosFiltrados == null || !productosFiltrados.Any())
        {
            <div class="text-center py-5 text-white-50 fs-4">
                No hay productos registrados en la base de datos.
            </div>
        }
        else
        {
            @foreach (var prod in productosFiltrados)
            {
                <div class="row align-items-center bg-black py-3 mb-3 rounded border border-secondary px-3">
                    <div class="col-md-4 d-flex align-items-center gap-3">
                        <img src="@(string.IsNullOrEmpty(prod.ImagenUrl) ? "/camisa-polo.png" : prod.ImagenUrl)" 
                             alt="@prod.Nombre" 
                             style="width: 70px; height: 70px; object-fit: contain; background: #fff;" 
                             class="rounded border" />
                        <h4 class="fw-bold m-0 fs-4">@prod.Nombre</h4>
                    </div>

                    <div class="col-md-2 text-center fs-4 fw-bold text-capitalize">
                        @prod.NombreMarca
                    </div>

                    <div class="col-md-2 text-center fs-4 fw-bold text-info">
                        $@prod.Precio.ToString("F2")
                    </div>

                    <div class="col-md-1 text-center fs-4 fw-bold">
                        @prod.Stock
                    </div>

                    <div class="col-md-3 d-flex justify-content-center gap-2">
                        <button class="btn btn-warning text-dark fw-bold px-3 py-2 fs-5" 
                                @onclick="() => AbrirFormularioEditar(prod)">
                            Editar
                        </button>
                        <button class="btn btn-danger text-white fw-bold px-3 py-2 fs-5" 
                                @onclick="() => SolicitarConfirmacionEliminar(prod)">
                            Eliminar
                        </button>
                    </div>
                </div>
            }
        }
    }
    else
    {
        <!-- ========================================== -->
        <!--  VISTA 2: FORMULARIO SEGÚN EL PROTOTIPO    -->
        <!-- ========================================== -->
        <div class="d-flex justify-content-between align-items-center mb-5">
            <h1 class="fw-bold display-3 m-0">
                @(productoEdicion.Id == 0 ? "Nuevo Producto" : "Editar Producto")
            </h1>
            <button class="btn btn-info text-white fw-bold px-4 py-3 fs-4 rounded-3" 
                    style="background-color: #00a8ff; border: none; min-width: 160px;" 
                    @onclick="CancelarFormulario">
                Volver
            </button>
        </div>

        <div class="row justify-content-center g-5 align-items-start">
            <!-- Columna Izquierda: Vista Previa de Imagen -->
            <div class="col-md-5 d-flex flex-column align-items-center">
                <div class="bg-secondary rounded-3 d-flex align-items-center justify-content-center text-white border border-secondary mb-3 w-100" 
                     style="height: 380px; overflow: hidden; background-color: #4a4a4a !important;">
                    @if (!string.IsNullOrEmpty(productoEdicion.ImagenUrl))
                    {
                        <img src="@productoEdicion.ImagenUrl" alt="Vista previa" style="max-height: 100%; max-width: 100%; object-fit: contain;" />
                    }
                    else
                    {
                        <span class="fs-1 fw-bold text-white-50">Imagen</span>
                    }
                </div>
                <div class="w-100">
                    <label class="form-label fw-bold fs-5">URL / Ruta de la Imagen</label>
                    <input type="text" 
                           class="form-control bg-secondary text-white fs-5 p-3 @(errores.ContainsKey("ImagenUrl") ? "border border-danger" : "border-0")" 
                           @bind="productoEdicion.ImagenUrl" 
                           @bind:event="oninput"
                           placeholder="/camisa-polo.png" />
                    @if (errores.TryGetValue("ImagenUrl", out var errorImagen))
                    {
                        <div class="text-danger fw-bold mt-1">@errorImagen</div>
                    }
                </div>
            </div>

            <!-- Columna Derecha: Campos de Entrada -->
            <div class="col-md-7">
                <div class="mb-4">
                    <label class="form-label fw-bold fs-4">Nombre</label>
                    <input type="text" 
                           class="form-control bg-secondary text-white fs-5 p-3 @(errores.ContainsKey("Nombre") ? "border border-danger" : "border-0")" 
                           @bind="productoEdicion.Nombre" 
                           placeholder="Nombre del producto" />
                    @if (errores.TryGetValue("Nombre", out var errorNombre))
                    {
                        <div class="text-danger fw-bold mt-1">@errorNombre</div>
                    }
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold fs-4">Descripcion</label>
                    <textarea class="form-control bg-secondary text-white fs-5 p-3 @(errores.ContainsKey("Descripcion") ? "border border-danger" : "border-0")" 
                              rows="3" 
                              @bind="productoEdicion.Descripcion" 
                              placeholder="Descripción detallada de la prenda"></textarea>
                    @if (errores.TryGetValue("Descripcion", out var errorDescripcion))
                    {
                        <div class="text-danger fw-bold mt-1">@errorDescripcion</div>
                    }
                </div>

                <!-- DESPLEGABLE DINÁMICO DE MARCAS DESDE LA API -->
                <div class="mb-4">
                    <label class="form-label fw-bold fs-4">Marca</label>
                    <select class="form-select bg-secondary text-white fs-5 p-3 @(errores.ContainsKey("MarcaId") ? "border border-danger" : "border-0")" @bind="idMarcaSeleccionada">
                        @if (listaMarcas == null || !listaMarcas.Any())
                        {
                            <option value="0">-- Cargando marcas... --</option>
                        }
                        else
                        {
                            @foreach (var m in listaMarcas)
                            {
                                <option value="@m.Id">@m.Nombre</option>
                            }
                        }
                    </select>
                    @if (errores.TryGetValue("MarcaId", out var errorMarca))
                    {
                        <div class="text-danger fw-bold mt-1">@errorMarca</div>
                    }
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold fs-4">Categoría</label>
                    <select class="form-select bg-secondary text-white fs-5 p-3 @(errores.ContainsKey("CategoriaId") ? "border border-danger" : "border-0")" @bind="idCategoriaSeleccionada">
                        @if (listaCategorias == null || !listaCategorias.Any())
                        {
                            <option value="0">Crea una categoría primero</option>
                        }
                        else
                        {
                            @foreach (var categoria in listaCategorias)
                            {
                                <option value="@categoria.Id">@categoria.Nombre</option>
                            }
                        }
                    </select>
                    @if (errores.TryGetValue("CategoriaId", out var errorCategoria))
                    {
                        <div class="text-danger fw-bold mt-1">@errorCategoria</div>
                    }
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold fs-4">Talla</label>
                        <select class="form-select bg-secondary text-white fs-5 p-3 @(errores.ContainsKey("Talla") ? "border border-danger" : "border-0")" @bind="productoEdicion.Talla">
                            @foreach (var talla in TallasDisponibles)
                            {
                                <option value="@talla">@talla</option>
                            }
                        </select>
                        @if (errores.TryGetValue("Talla", out var errorTalla))
                        {
                            <div class="text-danger fw-bold mt-1">@errorTalla</div>
                        }
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold fs-4">Color</label>
                        <input type="text" class="form-control bg-secondary text-white fs-5 p-3 @(errores.ContainsKey("Color") ? "border border-danger" : "border-0")" @bind="productoEdicion.Color" placeholder="Negro" />
                        @if (errores.TryGetValue("Color", out var errorColor))
                        {
                            <div class="text-danger fw-bold mt-1">@errorColor</div>
                        }
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold fs-4">Precio</label>
                        <input type="number" 
                               step="0.01" 
                               class="form-control bg-secondary text-white fs-5 p-3 @(errores.ContainsKey("Precio") ? "border border-danger" : "border-0")" 
                               @bind="productoEdicion.Precio" />
                        @if (errores.TryGetValue("Precio", out var errorPrecio))
                        {
                            <div class="text-danger fw-bold mt-1">@errorPrecio</div>
                        }
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold fs-4">Stock</label>
                        <input type="number" 
                               class="form-control bg-secondary text-white fs-5 p-3 @(errores.ContainsKey("Stock") ? "border border-danger" : "border-0")" 
                               @bind="productoEdicion.Stock" />
                        @if (errores.TryGetValue("Stock", out var errorStock))
                        {
                            <div class="text-danger fw-bold mt-1">@errorStock</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Botones Inferiores Centrados -->
        <div class="row mt-5">
            <div class="col-12 d-flex justify-content-center gap-4">
                <button class="btn btn-info text-white fw-bold px-5 py-3 fs-3 rounded-2" 
                        style="background-color: #00a8ff; border: none; min-width: 220px;" 
                        @onclick="GuardarProducto">
                    Guardar
                </button>
                <button class="btn btn-light text-dark fw-bold px-5 py-3 fs-3 rounded-2" 
                        style="min-width: 220px;" 
                        @onclick="CancelarFormulario">
                    Cancelar
                </button>
            </div>
        </div>
    }

    <!-- Mensaje de Feedback -->
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="row mt-4">
            <div class="col-12 text-center">
                <div class="alert alert-info d-inline-block px-4 py-2 fs-5" role="alert">
                    @mensaje
                </div>
            </div>
        </div>
    }

</div>

<!-- MODAL DE CONFIRMACIÓN DE ELIMINACIÓN -->
@if (mostrarModalConfirmacion)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.85);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white border border-secondary p-3">
                <div class="modal-header border-0 pb-0">
                    <h4 class="modal-title fw-bold text-danger">⚠️ Confirmar eliminación</h4>
                    <button type="button" class="btn-close btn-close-white" @onclick="CancelarEliminacion"></button>
                </div>
                <div class="modal-body py-4 fs-4 text-center">
                    ¿Estás seguro de que deseas eliminar el producto <strong class="text-info">"@productoAEliminar?.Nombre"</strong>?
                </div>
                <div class="modal-footer border-0 d-flex justify-content-center gap-3">
                    <button type="button" class="btn btn-danger fw-bold px-4 py-2 fs-5" @onclick="ConfirmarEliminarProducto">
                        Sí, eliminar
                    </button>
                    <button type="button" class="btn btn-secondary fw-bold px-4 py-2 fs-5" @onclick="CancelarEliminacion">
                        Cancelar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CamisaSalidaDTO> productos = new();
    private List<MarcaSalidaDTO> listaMarcas = new();
    private List<CategoriaSalidaDTO> listaCategorias = new();
    private int idMarcaSeleccionada = 1;
    private int idCategoriaSeleccionada;

    private string criterioBusqueda = string.Empty;
    private string mensaje = string.Empty;
    private Dictionary<string, string> errores = new();
    private bool cargando = true;
    private bool mostrarFormulario = false;

    private bool mostrarModalConfirmacion = false;
    private CamisaSalidaDTO? productoAEliminar = null;

    private CamisaSalidaDTO productoEdicion = new();
    private static readonly string[] TallasBase = ["S", "M", "L", "XL", "XXL"];

    private IEnumerable<string> TallasDisponibles
    {
        get
        {
            var nombres = new List<string>(TallasBase);
            foreach (var producto in productos)
            {
                AgregarTallaLista(nombres, producto.Talla);
                if (producto.Tallas == null)
                    continue;

                foreach (var talla in producto.Tallas)
                    AgregarTallaLista(nombres, talla.Talla);
            }

            AgregarTallaLista(nombres, productoEdicion.Talla);
            return nombres;
        }
    }

    private static void AgregarTallaLista(List<string> nombres, string? talla)
    {
        if (string.IsNullOrWhiteSpace(talla))
            return;

        var limpia = talla.Trim();
        if (nombres.Any(n => n.Equals(limpia, StringComparison.OrdinalIgnoreCase)))
            return;

        nombres.Add(limpia);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        if (!await AuthService.IsAuthenticated())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await CargarProductosDesdeApi();
        await CargarCatalogos();
        StateHasChanged();
    }

    private async Task CargarCatalogos()
    {
        try
        {
            listaMarcas = await MarcaService.ObtenerTodasAsync();
            listaCategorias = await CategoriaService.ObtenerTodasAsync();
        }
        catch
        {
        }
    }

    private async Task CargarProductosDesdeApi()
    {
        cargando = true;
        try
        {
            productos = await CamisaService.ObtenerTodasAsync();
        }
        catch (Exception ex)
        {
            mensaje = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private IEnumerable<CamisaSalidaDTO> productosFiltrados =>
        string.IsNullOrWhiteSpace(criterioBusqueda)
            ? productos
            : productos.Where(p => p.Nombre.Contains(criterioBusqueda, StringComparison.OrdinalIgnoreCase) ||
                                  (p.Marca != null && p.Marca.Nombre.Contains(criterioBusqueda, StringComparison.OrdinalIgnoreCase)));

    private void FiltrarProductos() { }

    private async Task AbrirFormularioNuevo()
    {
        if (!listaMarcas.Any() || !listaCategorias.Any())
            await CargarCatalogos();

        idMarcaSeleccionada = listaMarcas.FirstOrDefault()?.Id ?? 0;
        idCategoriaSeleccionada = listaCategorias.FirstOrDefault()?.Id ?? 0;

        productoEdicion = new CamisaSalidaDTO
        {
            Stock = 10,
            Precio = 25.00m,
            Talla = "M",
            Color = "Negro"
        };
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private async Task AbrirFormularioEditar(CamisaSalidaDTO prod)
    {
        if (!listaMarcas.Any() || !listaCategorias.Any())
            await CargarCatalogos();

        productoEdicion = new CamisaSalidaDTO
        {
            Id = prod.Id,
            Nombre = prod.Nombre,
            Descripcion = prod.Descripcion,
            Precio = prod.Precio,
            Stock = prod.Stock,
            ImagenUrl = prod.ImagenUrl,
            Talla = string.IsNullOrWhiteSpace(prod.Talla) ? "M" : prod.Talla,
            Color = prod.Color,
            Tallas = prod.Tallas
        };
        CargarTallasGuardadas(prod);

        idMarcaSeleccionada = prod.Marca?.Id ?? listaMarcas.FirstOrDefault()?.Id ?? 0;
        idCategoriaSeleccionada = prod.Categoria?.Id ?? listaCategorias.FirstOrDefault()?.Id ?? 0;
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private void CancelarFormulario()
    {
        mostrarFormulario = false;
        mensaje = string.Empty;
    }

    private void CargarTallasGuardadas(CamisaSalidaDTO prod)
    {
        var guardada = prod.Tallas?.FirstOrDefault(t => !string.IsNullOrWhiteSpace(t.Talla));
        if (guardada == null)
            return;

        productoEdicion.Talla = guardada.Talla;
        productoEdicion.Stock = guardada.Stock;
    }

    private async Task GuardarProducto()
    {
        try
        {
            var datos = new CamisaGuardarDTO
            {
                Nombre = productoEdicion.Nombre,
                Descripcion = productoEdicion.Descripcion,
                Precio = productoEdicion.Precio,
                Stock = productoEdicion.Stock,
                ImagenUrl = productoEdicion.ImagenUrl,
                Talla = productoEdicion.Talla ?? string.Empty,
                Color = productoEdicion.Color,
                MarcaId = idMarcaSeleccionada,
                CategoriaId = idCategoriaSeleccionada
            };
            errores = ValidacionFormulario.Errores(datos);
            if (errores.Count > 0)
            {
                mensaje = "Revisa los campos marcados en rojo.";
                return;
            }

            var resultado = await CamisaService.GuardarAsync(datos, productoEdicion.Id);
            mensaje = resultado.Mensaje;
            if (resultado.Ok)
            {
                mostrarFormulario = false;
                await CargarProductosDesdeApi();
            }
        }
        catch (Exception ex)
        {
            mensaje = ex.Message;
        }
    }

    private void SolicitarConfirmacionEliminar(CamisaSalidaDTO prod)
    {
        productoAEliminar = prod;
        mostrarModalConfirmacion = true;
    }

    private void CancelarEliminacion()
    {
        productoAEliminar = null;
        mostrarModalConfirmacion = false;
    }

    private async Task ConfirmarEliminarProducto()
    {
        if (productoAEliminar == null) return;

        int idEliminar = productoAEliminar.Id;
        string nombreProd = productoAEliminar.Nombre;

        var resultado = await CamisaService.EliminarAsync(idEliminar);
        mensaje = resultado.Ok ? $"Producto '{nombreProd}' eliminado." : resultado.Mensaje;
        if (resultado.Ok)
            await CargarProductosDesdeApi();

        mostrarModalConfirmacion = false;
        productoAEliminar = null;
    }
}