@page "/admin/usuarios"
@inject NavigationManager Navigation
@inject AuthService AuthService
@inject UsuarioService UsuarioService

<PageTitle>Administración de Usuarios - MarketLocalShirts</PageTitle>

<div class="container my-5 text-white">
    <h1 class="text-center mb-4 fw-bold display-3">Usuarios</h1>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="row mb-4">
            <div class="col-12 text-center">
                <div class="alert @(esError ? "alert-danger" : "alert-success") d-inline-block px-4 py-3 fs-5" role="alert">
                    @mensaje
                </div>
            </div>
        </div>
    }

    <!-- Buscador de Usuarios -->
    <div class="row justify-content-center mb-5">
        <div class="col-md-8 d-flex gap-2">
            <input type="text" 
                   class="form-control bg-secondary text-white border-0 fs-5 p-3" 
                   placeholder="Buscar usuario..." 
                   @bind="criterioBusqueda" 
                   @bind:event="oninput" />
            <button class="btn btn-info text-white fw-bold px-4 fs-5" 
                    style="min-width: 140px;"
                    @onclick="BuscarUsuarios">
                Buscar
            </button>
        </div>
    </div>

    <!-- Encabezados de la Lista -->
    <div class="row text-white fw-bold fs-4 mb-3 px-3">
        <div class="col-md-4">Usuarios</div>
        <div class="col-md-2 text-center">Rol</div>
        <div class="col-md-2 text-center">Estado</div>
        <div class="col-md-4 text-center">Acciones</div>
    </div>

    <!-- Filas de Usuarios -->
    @if (cargando)
    {
        <div class="text-center py-5 text-info fs-4">
            Cargando usuarios desde la base de datos...
        </div>
    }
    else if (usuarios == null || !usuarios.Any())
    {
        <div class="text-center py-5 text-muted fs-4">
            No se encontraron usuarios registrados.
        </div>
    }
    else
    {
        @foreach (var usr in usuariosFiltrados)
        {
            bool esAdmin = IsAdminRol(usr.Rol);

            <div class="row align-items-center bg-black py-3 mb-3 rounded border border-secondary px-3">
                <!-- Nombre y Correo -->
                <div class="col-md-4">
                    <h4 class="fw-bold m-0 fs-4">@usr.Nombre</h4>
                    <p class="text-white-50 m-0 fs-5">@usr.Correo</p>
                </div>

                <!-- Rol -->
                <div class="col-md-2 text-center fs-4 fw-bold">
                    @(esAdmin ? "Admin" : "Cliente")
                </div>

                <!-- Estado -->
                <div class="col-md-2 text-center fs-4 fw-bold @(usr.Activo == false ? "text-danger" : "text-success")">
                    @(usr.Activo == false ? "Suspendido" : "Activo")
                </div>

                <!-- Acciones -->
                <div class="col-md-4 d-flex justify-content-center gap-2">
                    <button class="btn @(esAdmin ? "btn-warning text-dark" : "btn-info text-white") fw-bold px-3 py-2 fs-5"
                            @onclick="() => CambiarRol(usr)">
                        @(esAdmin ? "Cliente" : "Admin")
                    </button>

                    <button class="btn btn-light text-dark fw-bold px-3 py-2 fs-5"
                            @onclick="() => CambiarEstado(usr)">
                        @(usr.Activo == false ? "Activar" : "Suspender")
                    </button>

                    <button class="btn btn-light text-dark fw-bold px-3 py-2 fs-5"
                            @onclick="() => AbrirClave(usr)">
                        Clave
                    </button>
                </div>
            </div>
        }
    }

</div>

@if (mostrarClave && usuarioClave != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.85);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white border border-secondary p-3">
                <div class="modal-header border-0">
                    <h4 class="modal-title fw-bold">Enlace de clave para @usuarioClave.Nombre</h4>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarClave"></button>
                </div>
                <div class="modal-body">
                    @if (esError && !string.IsNullOrEmpty(mensaje))
                    {
                        <div class="alert alert-danger py-2">@mensaje</div>
                    }
                    <p class="mb-2">Se enviará el enlace para cambiar la contraseña a:</p>
                    <p class="fw-bold mb-0">@usuarioClave.Correo</p>
                    <p class="text-white-50 mt-3 mb-0">El enlace llega al correo y sirve por 30 minutos. El usuario abre el mensaje y elige su nueva clave.</p>
                </div>
                <div class="modal-footer border-0">
                    <button class="btn text-white fw-bold" style="background-color: #00a8ff;" @onclick="EnviarEnlaceClave" disabled="@enviandoClave">Enviar enlace</button>
                    <button class="btn btn-secondary fw-bold" @onclick="CerrarClave">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string criterioBusqueda = string.Empty;
    private string mensaje = string.Empty;
    private bool esError = false;
    private bool cargando = true;
    private bool mostrarClave;
    private bool enviandoClave;
    private UsuarioSalidaDTO? usuarioClave;

    private List<UsuarioSalidaDTO> usuarios = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        if (!await AuthService.IsAuthenticated())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await CargarUsuariosDesdeApi();
        cargando = false;
        StateHasChanged();
    }

    private static bool IsAdminRol(string? rol)
    {
        if (string.IsNullOrWhiteSpace(rol)) return false;
        var r = rol.Trim().ToUpper();
        return r == "ADMIN" || r == "ROLE_ADMIN" || r == "1";
    }

    private async Task CargarUsuariosDesdeApi()
    {
        try
        {
            usuarios = await UsuarioService.ObtenerTodosAsync();
            esError = false;
        }
        catch (Exception ex)
        {
            esError = true;
            mensaje = ex.Message;
            usuarios = new List<UsuarioSalidaDTO>();
        }
    }

    private IEnumerable<UsuarioSalidaDTO> usuariosFiltrados =>
        string.IsNullOrWhiteSpace(criterioBusqueda) 
            ? usuarios 
            : usuarios.Where(u => (u.Nombre ?? "").Contains(criterioBusqueda, StringComparison.OrdinalIgnoreCase) || 
                                  (u.Correo ?? "").Contains(criterioBusqueda, StringComparison.OrdinalIgnoreCase));

    private void BuscarUsuarios() { }

    private async Task CambiarRol(UsuarioSalidaDTO usr)
    {
        esError = false;
        var nuevoRol = IsAdminRol(usr.Rol) ? "CLIENTE" : "ADMIN";
        var datos = DatosUsuario(usr, nuevoRol, usr.Activo != false);
        if (!ValidacionFormulario.EsValido(datos, out var errorValidacion))
        {
            esError = true;
            mensaje = errorValidacion;
            return;
        }

        var resultado = await UsuarioService.ActualizarAsync(usr.Id, datos);
        esError = !resultado.Ok;
        mensaje = resultado.Ok ? $"Rol de {usr.Nombre} actualizado a {(nuevoRol == "ADMIN" ? "Admin" : "Cliente")}." : resultado.Mensaje;
        if (resultado.Ok)
            await CargarUsuariosDesdeApi();
    }

    private async Task CambiarEstado(UsuarioSalidaDTO usr)
    {
        esError = false;
        var activar = usr.Activo == false;
        var datos = DatosUsuario(usr, string.IsNullOrWhiteSpace(usr.Rol) ? "CLIENTE" : usr.Rol, activar);
        if (!ValidacionFormulario.EsValido(datos, out var errorValidacion))
        {
            esError = true;
            mensaje = errorValidacion;
            return;
        }

        var resultado = await UsuarioService.ActualizarAsync(usr.Id, datos);

        esError = !resultado.Ok;
        mensaje = resultado.Ok
            ? (activar
                ? $"{usr.Nombre} quedó activo y ya puede iniciar sesión."
                : $"{usr.Nombre} quedó suspendido. Su cuenta está bloqueada y no puede iniciar sesión.")
            : resultado.Mensaje;

        if (resultado.Ok)
        {
            usr.Activo = activar;
            await CargarUsuariosDesdeApi();
        }
    }

    private void AbrirClave(UsuarioSalidaDTO usr)
    {
        usuarioClave = usr;
        mostrarClave = true;
        esError = false;
        mensaje = string.Empty;
    }

    private void CerrarClave()
    {
        mostrarClave = false;
        usuarioClave = null;
        enviandoClave = false;
    }

    private async Task EnviarEnlaceClave()
    {
        if (usuarioClave == null || string.IsNullOrWhiteSpace(usuarioClave.Correo))
        {
            esError = true;
            mensaje = "Ese usuario no tiene correo.";
            return;
        }

        enviandoClave = true;
        var resultado = await AuthService.SolicitarRecuperacionAsync(usuarioClave.Correo);
        enviandoClave = false;
        esError = !resultado.Ok;
        mensaje = resultado.Ok
            ? $"Se envió el enlace de clave a {usuarioClave.Correo}."
            : resultado.Mensaje;

        if (resultado.Ok)
            CerrarClave();
    }

    private static UsuarioModificarDTO DatosUsuario(UsuarioSalidaDTO usr, string rol, bool activo)
    {
        return new UsuarioModificarDTO
        {
            Nombre = usr.Nombre,
            Correo = usr.Correo,
            Telefono = string.IsNullOrWhiteSpace(usr.Telefono) ? null : usr.Telefono,
            Rol = rol,
            Activo = activo
        };
    }
}