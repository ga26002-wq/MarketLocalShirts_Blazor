@page "/admin/usuarios"
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject HttpClient Http
@using System.Net.Http.Json
@using System.Text.Json

<PageTitle>Administración de Usuarios - MarketLocalShirts</PageTitle>

<div class="container my-5 text-white">
    <h1 class="text-center mb-5 fw-bold display-3">Usuarios</h1>

    <!-- Buscador de Usuarios -->
    <div class="row justify-content-center mb-5">
        <div class="col-md-8 d-flex gap-2">
            <input type="text" 
                   class="form-control bg-secondary text-white border-0 fs-5 p-3" 
                   placeholder="Buscar usuario..." 
                   @bind="criterioBusqueda" 
                   @bind:event="oninput" />
            <button class="btn btn-info text-white fw-bold px-4 fs-5" 
                    style="min-width: 140px;"
                    @onclick="BuscarUsuarios">
                Buscar
            </button>
        </div>
    </div>

    <!-- Encabezados de la Lista -->
    <div class="row text-white fw-bold fs-4 mb-3 px-3">
        <div class="col-md-4">Usuarios</div>
        <div class="col-md-2 text-center">Rol</div>
        <div class="col-md-2 text-center">Estado</div>
        <div class="col-md-4 text-center">Acciones</div>
    </div>

    <!-- Filas de Usuarios -->
    @if (cargando)
    {
        <div class="text-center py-5 text-info fs-4">
            Cargando usuarios desde la base de datos...
        </div>
    }
    else if (usuarios == null || !usuarios.Any())
    {
        <div class="text-center py-5 text-muted fs-4">
            No se encontraron usuarios registrados.
        </div>
    }
    else
    {
        @foreach (var usr in usuariosFiltrados)
        {
            bool esAdmin = IsAdminRol(usr.Rol);

            <div class="row align-items-center bg-black py-3 mb-3 rounded border border-secondary px-3">
                <!-- Nombre y Correo -->
                <div class="col-md-4">
                    <h4 class="fw-bold m-0 fs-4">@usr.Nombre</h4>
                    <p class="text-white-50 m-0 fs-5">@usr.Correo</p>
                </div>

                <!-- Rol -->
                <div class="col-md-2 text-center fs-4 fw-bold">
                    @(string.IsNullOrEmpty(usr.Rol) ? "CLIENTE" : usr.Rol)
                </div>

                <!-- Estado -->
                <div class="col-md-2 text-center fs-4 fw-bold">
                    @(string.IsNullOrEmpty(usr.Estado) ? "Activa" : usr.Estado)
                </div>

                <!-- Acciones -->
                <div class="col-md-4 d-flex justify-content-center gap-2">
                    <button class="btn @(esAdmin ? "btn-warning text-dark" : "btn-info text-white") fw-bold px-3 py-2 fs-5" 
                            @onclick="() => CambiarRol(usr)">
                        @(esAdmin ? "Quitar Admin" : "Hacer Admin")
                    </button>
                    
                    <button class="btn btn-light text-dark fw-bold px-3 py-2 fs-5" 
                            @onclick="() => CambiarEstado(usr)">
                        @(usr.Estado == "Activa" || usr.Estado == "ACTIVO" || usr.Estado == "1" ? "Suspender" : "Activar")
                    </button>

                    <button class="btn btn-light text-dark fw-bold px-3 py-2 fs-5" 
                            @onclick="() => RestablecerClave(usr)">
                        Clave
                    </button>
                </div>
            </div>
        }
    }

    <!-- Alerta de Mensajes o Renovación de Sesión -->
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="row mt-4">
            <div class="col-12 text-center">
                <div class="alert @(tokenExpirado ? "alert-warning" : (esError ? "alert-danger" : "alert-success")) d-inline-block px-4 py-3 fs-5" role="alert">
                    <div>@mensaje</div>
                    @if (tokenExpirado)
                    {
                        <button class="btn btn-primary fw-bold mt-3 fs-5 px-4" @onclick="RedirigirLogin">
                            Inicia Sesión Aquí para Renovar
                        </button>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string criterioBusqueda = string.Empty;
    private string mensaje = string.Empty;
    private bool esError = false;
    private bool tokenExpirado = false;
    private bool cargando = true;

    private List<UsuarioAdminDTO> usuarios = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CargarUsuariosDesdeApi();
            cargando = false;
            StateHasChanged();
        }
    }

    private static bool IsAdminRol(string? rol)
    {
        if (string.IsNullOrWhiteSpace(rol)) return false;
        var r = rol.Trim().ToUpper();
        return r == "ADMIN" || r == "ROLE_ADMIN" || r == "1";
    }

    private async Task<string> ObtenerTokenLimpio()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
            if (string.IsNullOrEmpty(token))
            {
                token = await JS.InvokeAsync<string>("localStorage.getItem", "token");
            }

            if (!string.IsNullOrEmpty(token))
            {
                token = token.Trim('"').Trim();
                if (token.StartsWith("Bearer ", StringComparison.OrdinalIgnoreCase))
                {
                    token = token.Substring(7).Trim();
                }
            }
            return token ?? string.Empty;
        }
        catch
        {
            return string.Empty;
        }
    }

    private async Task LimpiarTokensCaducados()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", "authToken");
            await JS.InvokeVoidAsync("localStorage.removeItem", "token");
        }
        catch { }
    }

    private async Task CargarUsuariosDesdeApi()
    {
        try
        {
            var token = await ObtenerTokenLimpio();

            // 1. Intentar el endpoint de lista completa
            var request = new HttpRequestMessage(HttpMethod.Get, "api/usuarios/lista");
            if (!string.IsNullOrEmpty(token))
            {
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<List<UsuarioAdminDTO>>();
                if (result != null && result.Any())
                {
                    usuarios = result;
                    return;
                }
            }

            // 2. Fallback: intentar el endpoint paginado
            var reqFallback = new HttpRequestMessage(HttpMethod.Get, "api/usuarios");
            if (!string.IsNullOrEmpty(token))
            {
                reqFallback.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var resFallback = await Http.SendAsync(reqFallback);
            if (resFallback.IsSuccessStatusCode)
            {
                using var doc = await resFallback.Content.ReadFromJsonAsync<JsonDocument>();
                if (doc != null && doc.RootElement.TryGetProperty("content", out var contentElement))
                {
                    var listaPaginada = JsonSerializer.Deserialize<List<UsuarioAdminDTO>>(contentElement.GetRawText(), new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    if (listaPaginada != null && listaPaginada.Any())
                    {
                        usuarios = listaPaginada;
                        return;
                    }
                }
            }

            if (!usuarios.Any())
            {
                CargarUsuariosBase();
            }
        }
        catch
        {
            if (!usuarios.Any())
            {
                CargarUsuariosBase();
            }
        }
    }

    private void CargarUsuariosBase()
    {
        usuarios = new List<UsuarioAdminDTO>
        {
            new UsuarioAdminDTO { Id = 1, Nombre = "Sofia", Correo = "Sofia@gmail.com", Rol = "CLIENTE", Estado = "Activa" },
            new UsuarioAdminDTO { Id = 2, Nombre = "Josué Garay", Correo = "Josuedga007@gmail.com", Rol = "CLIENTE", Estado = "Activa" },
            new UsuarioAdminDTO { Id = 3, Nombre = "Mónica Ruballo", Correo = "Admin@gmail.com", Rol = "ADMIN", Estado = "Activa" }
        };
    }

    private IEnumerable<UsuarioAdminDTO> usuariosFiltrados =>
        string.IsNullOrWhiteSpace(criterioBusqueda) 
            ? usuarios 
            : usuarios.Where(u => (u.Nombre ?? "").Contains(criterioBusqueda, StringComparison.OrdinalIgnoreCase) || 
                                  (u.Correo ?? "").Contains(criterioBusqueda, StringComparison.OrdinalIgnoreCase));

    private void BuscarUsuarios() { }

    private async Task CambiarRol(UsuarioAdminDTO usr)
    {
        esError = false;
        tokenExpirado = false;
        mensaje = "Guardando cambio de rol en SQL Server...";

        bool actualmenteEsAdmin = IsAdminRol(usr.Rol);
        int nuevoRolId = actualmenteEsAdmin ? 2 : 1;
        string nuevoRolTexto = actualmenteEsAdmin ? "CLIENTE" : "ADMIN";

        try
        {
            var token = await ObtenerTokenLimpio();

            var request = new HttpRequestMessage(HttpMethod.Put, $"api/usuarios/{usr.Id}");
            if (!string.IsNullOrEmpty(token))
            {
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var payload = new 
            { 
                id = usr.Id, 
                nombre = usr.Nombre, 
                correo = usr.Correo, 
                idRol = nuevoRolId,
                rolId = nuevoRolId,
                rol = nuevoRolTexto,
                estado = usr.Estado ?? "Activa"
            };

            request.Content = JsonContent.Create(payload);

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                usr.Rol = nuevoRolTexto;
                mensaje = $"¡Guardado en la Base de Datos! Rol de {usr.Nombre} actualizado a {nuevoRolTexto}.";
                esError = false;
                await CargarUsuariosDesdeApi();
                StateHasChanged();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Forbidden || response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                await LimpiarTokensCaducados();
                tokenExpirado = true;
                mensaje = "Tu sesión de token expiró. Inicia sesión de nuevo para guardar en SQL Server:";
            }
            else
            {
                esError = true;
                var errBody = await response.Content.ReadAsStringAsync();
                mensaje = $"Error de API BD (Código {(int)response.StatusCode}): {errBody}";
            }
        }
        catch (Exception ex)
        {
            esError = true;
            mensaje = $"Error de conexión: {ex.Message}";
        }
    }

    private async Task CambiarEstado(UsuarioAdminDTO usr)
    {
        esError = false;
        tokenExpirado = false;
        string nuevoEstado = (usr.Estado == "Activa" || usr.Estado == "ACTIVO" || usr.Estado == "1") ? "Inactiva" : "Activa";

        bool actualmenteEsAdmin = IsAdminRol(usr.Rol);
        int rolIdActual = actualmenteEsAdmin ? 1 : 2;

        try
        {
            var token = await ObtenerTokenLimpio();

            var request = new HttpRequestMessage(HttpMethod.Put, $"api/usuarios/{usr.Id}");
            if (!string.IsNullOrEmpty(token))
            {
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var payload = new 
            { 
                id = usr.Id, 
                nombre = usr.Nombre, 
                correo = usr.Correo, 
                idRol = rolIdActual, 
                rolId = rolIdActual,
                estado = nuevoEstado 
            };

            request.Content = JsonContent.Create(payload);
            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                usr.Estado = nuevoEstado;
                mensaje = $"¡Guardado en SQL Server! Estado de {usr.Nombre} cambió a {nuevoEstado}.";
                await CargarUsuariosDesdeApi();
                StateHasChanged();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Forbidden || response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                await LimpiarTokensCaducados();
                tokenExpirado = true;
                mensaje = "Sesión expirada. Por favor vuelve a iniciar sesión.";
            }
            else
            {
                esError = true;
                var errBody = await response.Content.ReadAsStringAsync();
                mensaje = $"Error al cambiar estado (Código {(int)response.StatusCode}): {errBody}";
            }
        }
        catch (Exception ex)
        {
            esError = true;
            mensaje = $"Error de conexión: {ex.Message}";
        }
    }

    private void RestablecerClave(UsuarioAdminDTO usr)
    {
        mensaje = $"Se envió la solicitud de clave a {usr.Correo}.";
    }

    private void RedirigirLogin()
    {
        Navigation.NavigateTo("/login");
    }

    public class UsuarioAdminDTO
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string Correo { get; set; } = string.Empty;
        public string Rol { get; set; } = string.Empty;
        public string Estado { get; set; } = string.Empty;
    }
}