@page "/categoria/delete/{pId:int}"
@rendermode InteractiveServer
@inject CategoriaService CategoriaService
@inject NavigationManager Navigation

<PageTitle>Eliminar categoría</PageTitle>

<div class="container my-5 text-white">
    <h3 class="mb-4">Eliminar Categoría</h3>

    <EditForm Model="categoriaModificar" OnValidSubmit="Eliminar">
        <div class="mb-3">
            <label class="form-label">Nombre</label>
            <InputText class="form-control" readonly="readonly" @bind-Value="categoriaModificar.Nombre" />
        </div>
        <div class="mb-3">
            <label class="form-label">Descripción</label>
            <InputText class="form-control" readonly="readonly" @bind-Value="categoriaModificar.Descripcion" />
        </div>

        <button type="submit" class="btn btn-danger">Eliminar</button>
        <button type="button" class="btn btn-dark" @onclick="Index">Regresar</button>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-3">@errorMessage</div>
        }
    </EditForm>
</div>

@code {
    [Parameter]
    public int pId { get; set; }

    private CategoriaModificarDTO categoriaModificar = new();
    private string? errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var categoria = await CategoriaService.ObtenerPorIdAsync(pId);
        if (categoria == null)
            return;

        categoriaModificar.Id = categoria.Id;
        categoriaModificar.Nombre = categoria.Nombre;
        categoriaModificar.Descripcion = categoria.Descripcion ?? string.Empty;
        StateHasChanged();
    }

    private async Task Eliminar()
    {
        var resultado = await CategoriaService.EliminarAsync(categoriaModificar.Id);
        if (resultado.Ok)
        {
            Index();
            return;
        }

        errorMessage = resultado.Mensaje;
    }

    private void Index() => Navigation.NavigateTo("/categoria/index");
}
