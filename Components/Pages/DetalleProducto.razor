@page "/producto/{Id:int}"
@rendermode InteractiveServer
@inject CamisaService CamisaService
@inject NavigationManager Navigation
@inject CarritoService CarritoService

<PageTitle>Detalle de Producto - MarketLocalShirts</PageTitle>

<div class="bg-black text-white min-vh-100 py-5 px-3 px-md-5">
    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-info" role="status">
                <span class="visually-hidden">Cargando detalles...</span>
            </div>
        </div>
    }
    else if (producto == null)
    {
        <div class="text-center py-5">
            <h3 class="fw-bold text-danger">El producto no fue encontrado.</h3>
            <button class="btn btn-outline-light mt-3 px-4 py-2" @onclick="VolverAlCatalogo">Volver al catálogo</button>
        </div>
    }
    else
    {
        <!-- Botón para regresar al catálogo -->
        <div class="mb-4">
            <button class="btn btn-outline-secondary text-white fw-bold px-4 py-2 rounded-2 border-0" 
                    style="background-color: #222;" 
                    @onclick="VolverAlCatalogo">
                <i class="bi bi-arrow-left"></i> ← Volver al Catálogo
            </button>
        </div>

        <div class="row g-4 align-items-center bg-dark p-3 p-md-4 rounded-3 border border-secondary mx-auto" style="max-width: 860px;">
            <!-- Columna Izquierda: Imagen del Producto -->
            <div class="col-lg-6">
                <div class="bg-white p-3 rounded-3 d-flex align-items-center justify-content-center position-relative" style="min-height: 280px;">
                    <span class="position-absolute top-0 end-0 m-2 badge px-2 py-1 rounded-pill fw-bold" 
                          style="background-color: #0084ff !important; color: white;">
                        @(string.IsNullOrEmpty(producto.NombreMarca) ? "MLS" : producto.NombreMarca)
                    </span>
                    <img src="@ObtenerImagenValida(producto)" alt="@producto.Nombre" class="img-fluid" style="max-height: 240px; object-fit: contain;" />
                </div>
            </div>

            <!-- Columna Derecha: Información y Compra -->
            <div class="col-lg-6">
                <div class="text-info text-uppercase fw-bold small mb-1" style="letter-spacing: 1px;">
                    @(string.IsNullOrEmpty(producto.NombreMarca) ? "CLASICO" : producto.NombreMarca)
                </div>

                <h1 class="fw-bold mb-2 text-white" style="font-size: 1.6rem;">@producto.Nombre</h1>
                
                <div class="fs-4 fw-bold mb-3" style="color: #00a8ff;">$@producto.Precio.ToString("0.00")</div>

                <p class="text-secondary mb-3 pb-3 border-bottom border-secondary">
                    @producto.Descripcion
                </p>

                <div class="mb-3 text-white-50">
                    <span>📦 <strong class="text-white">@StockSeleccionado</strong> disponibles</span>
                </div>

                @if (producto.Tallas != null && producto.Tallas.Any())
                {
                    <div class="mb-3" style="max-width: 220px;">
                        <label class="form-label text-uppercase small fw-bold mb-1 text-white-50">Talla</label>
                        <select class="form-select bg-secondary text-white border-0 py-2" @bind="tallaSeleccionada">
                            @foreach (var talla in producto.Tallas)
                            {
                                <option value="@talla.Talla">@talla.Talla (@talla.Stock)</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">Esta camisa no tiene talla con stock. El pedido necesita una talla.</div>
                }

                <!-- Selector de Cantidad -->
                <div class="mb-3" style="max-width: 220px;">
                    <label class="form-label text-uppercase small fw-bold mb-1 text-white-50" style="letter-spacing: 1px;">Cantidad</label>
                    <input type="number" class="form-control bg-secondary text-white border-0 py-2 text-center" 
                           @bind="cantidad" min="1" max="@(StockSeleccionado > 0 ? StockSeleccionado : 1)" />
                </div>

                <!-- Botón Agregar al Carrito -->
                <button class="btn fw-semibold py-2 px-4 rounded-pill text-white btn-agregar-bolsa" 
                        style="background-color: #00a8ff; border: none;"
                        disabled="@(!PuedeAgregar)"
                        @onclick="AgregarAlCarrito">
                    🛒 AGREGAR AL CARRITO
                </button>

                @if (!string.IsNullOrEmpty(mensajeFeedback))
                {
                    <div class="alert alert-info mt-3 rounded-3 text-center py-2 fs-5">
                        @mensajeFeedback
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    .btn-agregar-bolsa:hover {
        background-color: #0084ff !important;
    }
</style>

@code {
    [Parameter]
    public int Id { get; set; }

    private CamisaSalidaDTO? producto;
    private bool cargando = true;
    private int cantidad = 1;
    private string tallaSeleccionada = string.Empty;
    private string mensajeFeedback = string.Empty;

    private int StockSeleccionado =>
        producto?.Tallas?.FirstOrDefault(t => t.Talla == tallaSeleccionada)?.Stock ?? 0;

    private bool PuedeAgregar =>
        producto != null &&
        !string.IsNullOrWhiteSpace(tallaSeleccionada) &&
        StockSeleccionado > 0 &&
        cantidad >= 1 &&
        cantidad <= StockSeleccionado;

    protected override async Task OnInitializedAsync()
    {
        await CargarDetalleProducto();
    }

    private async Task CargarDetalleProducto()
    {
        cargando = true;
        try
        {
            producto = await CamisaService.ObtenerPorIdAsync(Id);
            tallaSeleccionada = producto?.Tallas?.FirstOrDefault(t => t.Stock > 0)?.Talla
                ?? producto?.Tallas?.FirstOrDefault()?.Talla
                ?? string.Empty;
        }
        catch
        {
            producto = null;
        }
        finally
        {
            cargando = false;
        }
    }

    private string ObtenerImagenValida(CamisaSalidaDTO camisa)
    {
        if (string.IsNullOrWhiteSpace(camisa.ImagenUrl) || 
            !camisa.ImagenUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase) || 
            camisa.ImagenUrl == "url_imagen_ejemplo")
        {
            if (camisa.Nombre.Contains("azul", StringComparison.OrdinalIgnoreCase))
            {
                return "https://png.pngtree.com/png-clipart/20230508/original/pngtree-blue-t-shirt-png-image_9153366.png";
            }
            return "https://png.pngtree.com/png-clipart/20230508/original/pngtree-black-t-shirt-png-image_9153361.png";
        }
        return camisa.ImagenUrl;
    }

    private async Task AgregarAlCarrito()
    {
        if (producto == null || !PuedeAgregar) return;

        try
        {
            await CarritoService.AgregarAsync(producto, tallaSeleccionada, cantidad);
            Navigation.NavigateTo("/carrito");
        }
        catch (Exception ex)
        {
            mensajeFeedback = $"Error al agregar: {ex.Message}";
            StateHasChanged();
        }
    }

    private void VolverAlCatalogo()
    {
        Navigation.NavigateTo("/catalogo");
    }
}