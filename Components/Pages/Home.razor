@page "/"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="container-fluid bg-black text-white min-vh-100 d-flex align-items-center justify-content-center px-5 py-4">
    <div class="row w-100 align-items-center justify-content-between my-auto">
        <!-- Columna Izquierda: Texto y Botón -->
        <div class="col-lg-6 mb-4 mb-lg-0 px-lg-5">
            <h1 class="display-3 fw-bold mb-2">MarketLocal Shirts</h1>
            <p class="fs-5 text-secondary mb-4">Tienda en línea de playeras para hombre</p>
            
            <a href="/catalogo" class="btn btn-info btn-lg fw-bold text-white px-4 py-2 mb-4 shadow" style="background-color: #00a8ff; border: none;">
                Ver Catálogo
            </a>

            <p class="fs-6 text-light mt-3">Explora nuestro catálogo y encuentra tu estilo ideal.</p>
        </div>

        <!-- Columna Derecha: Imagen de la camisa -->
        <div class="col-lg-5 text-center">
           <img src="images/camisa-polo.png" alt="Camisa Polo MLS" class="img-fluid" style="max-height: 480px; object-fit: contain;" />
        </div>
    </div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
                if (string.IsNullOrEmpty(token))
                {
                    token = await JS.InvokeAsync<string>("localStorage.getItem", "token");
                }

                if (!string.IsNullOrEmpty(token))
                {
                    var userRole = await JS.InvokeAsync<string>("localStorage.getItem", "userRole");
                    var userEmail = await JS.InvokeAsync<string>("localStorage.getItem", "userEmail");

                    string cleanRole = (userRole ?? "").Trim().Trim('"').ToUpper();
                    string cleanEmail = (userEmail ?? "").Trim().Trim('"');

                    bool esAdmin = cleanRole == "ADMIN" || cleanRole == "ROLE_ADMIN" || cleanRole == "1" ||
                                   cleanEmail.Equals("Admin@gmail.com", StringComparison.OrdinalIgnoreCase);

                    if (!esAdmin)
                    {
                        esAdmin = EsAdminToken(token);
                    }

                    if (esAdmin)
                    {
                        await JS.InvokeVoidAsync("localStorage.setItem", "userRole", "ADMIN");
                        Navigation.NavigateTo("/admin/usuarios");
                    }
                }
            }
            catch { }
        }
    }

    private static bool EsAdminToken(string token)
    {
        try
        {
            var parts = token.Split('.');
            if (parts.Length >= 2)
            {
                string payloadBase64 = parts[1];
                payloadBase64 = payloadBase64.Replace('-', '+').Replace('_', '/');
                switch (payloadBase64.Length % 4)
                {
                    case 2: payloadBase64 += "=="; break;
                    case 3: payloadBase64 += "="; break;
                }
                byte[] bytes = Convert.FromBase64String(payloadBase64);
                string jsonPayload = System.Text.Encoding.UTF8.GetString(bytes).ToUpper();

                return jsonPayload.Contains("ADMIN") || 
                       jsonPayload.Contains("ROLE_ADMIN") || 
                       jsonPayload.Contains("\"IDROL\":1") || 
                       jsonPayload.Contains("\"ROL\":1") ||
                       jsonPayload.Contains("\"ID_ROL\":1");
            }
        }
        catch { }
        return false;
    }
}