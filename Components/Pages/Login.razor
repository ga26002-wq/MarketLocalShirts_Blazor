@page "/login"
@rendermode InteractiveServer
@inject AuthService AuthService
@inject NavigationManager Navigation
@using System.ComponentModel.DataAnnotations
@using System.Text.Json.Serialization

<PageTitle>Iniciar Sesión - MarketLocalShirts</PageTitle>

<div class="login-wrapper d-flex align-items-center justify-content-center bg-black text-white px-3 py-5" style="min-height: calc(100vh - 60px);">
    <div class="card text-white p-4 shadow-lg border-0 rounded-3" style="max-width: 400px; width: 100%; background-color: #2b2b2b !important;">
        <div class="text-center mb-3">
            <h2 class="fw-bold fs-4 mb-1">¡Bienvenido!</h2>
            <p class="fs-6 text-light mb-0">Inicia sesión para continuar.</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger py-2 text-center rounded-3 mb-3 small">@errorMessage</div>
        }

        <div class="form-group mb-3">
            <label class="form-label fw-bold mb-1 small">Correo Electrónico</label>
            <input type="text" class="form-control bg-light text-dark rounded-2 @(errores.ContainsKey("Login") ? "border border-danger" : "border-0")" @bind="loginModel.Login" placeholder="tucorreo@email.com" />
            @if (errores.TryGetValue("Login", out var errorCorreo))
            {
                <div class="text-danger small fw-bold mt-1">@errorCorreo</div>
            }
        </div>

        <div class="form-group mb-4">
            <label class="form-label fw-bold mb-1 small">Contraseña</label>
            <div class="campo-clave">
                <input type="@(verClave ? "text" : "password")" class="form-control bg-light text-dark rounded-2 @(errores.ContainsKey("Clave") ? "border border-danger" : "border-0")" @bind="loginModel.Clave" placeholder="••••••••" />
                <button type="button" class="ojo-clave" @onclick="() => verClave = !verClave" title="@(verClave ? "Ocultar" : "Ver")">
                    <i class="bi @(verClave ? "bi-eye-slash" : "bi-eye")"></i>
                </button>
            </div>
            @if (errores.TryGetValue("Clave", out var errorClave))
            {
                <div class="text-danger small fw-bold mt-1">@errorClave</div>
            }
        </div>

        <button type="button" class="btn btn-info w-100 fw-bold text-white mb-3 rounded-2" style="background-color: #00a8ff; border: none; padding: 0.6rem;" @onclick="HandleLogin">
            Iniciar Sesión
        </button>

        <div class="text-center small">
            <p class="mb-1 text-light">
                ¿No tienes una cuenta?
                <a href="/registro" class="text-decoration-none fw-bold" style="color: #00a8ff;">Registrarse</a>
            </p>
            <p class="mb-0">
                <a href="/recuperar-contrasena" class="text-decoration-none fw-bold" style="color: #00a8ff;">Restablecer Contraseña</a>
            </p>
        </div>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private string? errorMessage;
    private bool verClave;
    private Dictionary<string, string> errores = new();

    private async Task HandleLogin()
    {
        errorMessage = null;
        errores = ValidacionFormulario.Errores(loginModel);
        if (errores.Count > 0)
            return;

        try
        {
            var resultado = await AuthService.LoginAsync(loginModel.Login, loginModel.Clave);
            if (!resultado.Ok || string.IsNullOrEmpty(resultado.Token))
            {
                errorMessage = resultado.Mensaje;
                return;
            }

            if (AuthService.TokenEsAdmin(resultado.Token))
                Navigation.NavigateTo("/admin/usuarios");
            else
                Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            errorMessage = $"Excepción: {ex.Message}";
        }
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "El correo es obligatorio")]
        [EmailAddress(ErrorMessage = "Debes escribir un correo válido, por ejemplo nombre@correo.com")]
        [JsonPropertyName("login")]
        public string Login { get; set; } = string.Empty;

        [Required(ErrorMessage = "La contraseña es obligatoria")]
        [JsonPropertyName("clave")]
        public string Clave { get; set; } = string.Empty;
    }

}