@page "/marca/delete/{pId:int}"
@rendermode InteractiveServer
@inject MarcaService MarcaService
@inject NavigationManager Navigation

<PageTitle>Eliminar marca</PageTitle>

<div class="container my-5 text-white">
    <h3 class="mb-4">Eliminar Marca</h3>

    <EditForm Model="marcaModificar" OnValidSubmit="Eliminar">
        <div class="mb-3">
            <label class="form-label">Nombre</label>
            <InputText class="form-control" readonly="readonly" @bind-Value="marcaModificar.Nombre" />
        </div>
        <div class="mb-3">
            <label class="form-label">Descripción</label>
            <InputText class="form-control" readonly="readonly" @bind-Value="marcaModificar.Descripcion" />
        </div>

        <button type="submit" class="btn btn-danger">Eliminar</button>
        <button type="button" class="btn btn-dark" @onclick="Index">Regresar</button>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-3">@errorMessage</div>
        }
    </EditForm>
</div>

@code {
    [Parameter]
    public int pId { get; set; }

    private MarcaModificarDTO marcaModificar = new();
    private string? errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var marca = await MarcaService.ObtenerPorIdAsync(pId);
        if (marca == null)
            return;

        marcaModificar.Id = marca.Id;
        marcaModificar.Nombre = marca.Nombre;
        marcaModificar.Descripcion = marca.Descripcion ?? string.Empty;
        StateHasChanged();
    }

    private async Task Eliminar()
    {
        var resultado = await MarcaService.EliminarAsync(marcaModificar.Id);
        if (resultado.Ok)
        {
            Index();
            return;
        }

        errorMessage = resultado.Mensaje;
    }

    private void Index() => Navigation.NavigateTo("/marca/index");
}
