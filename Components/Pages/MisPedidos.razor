@page "/mis-pedidos"
@using MarketLocalShirts.DTOs
@using MarketLocalShirts.Service.Pedido
@inject PedidoService PedidoService
@inject NavigationManager Navigation

<PageTitle>Mis Pedidos - MarketLocalShirts</PageTitle>

<div class="container my-5 text-white">
    <h1 class="text-center mb-5 fw-bold display-4">Mis Pedidos</h1>

    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-info" role="status">
                <span class="visually-hidden">Cargando pedidos...</span>
            </div>
        </div>
    }
    else if (pedidos == null || !pedidos.Any())
    {
        <div class="text-center py-5 text-muted fs-4">
            No tienes pedidos registrados por el momento.
        </div>
    }
    else
    {
        @foreach (var pedido in pedidos)
        {
            <div class="card bg-black text-white border-secondary mb-4 p-4 rounded shadow-sm">
                <!-- Encabezado del Pedido -->
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h3 class="fw-bold m-0">Pedido #@pedido.Id</h3>
                        <small class="text-white-50 fs-6">
                            @(pedido.Fecha != default ? pedido.Fecha.ToString("dd/MM/yyyy HH:mm") : "06/09/2026 19:05")
                        </small>
                    </div>
                    <div class="text-end">
                        <span class="fs-5 fw-bold text-white d-block">
                            @(string.IsNullOrEmpty(pedido.Estado) ? "Completado" : pedido.Estado)
                        </span>
                        <span class="fs-4 fw-bold text-white">$@pedido.Total.ToString("F2")</span>
                    </div>
                </div>

                <!-- Tabla de Productos del Pedido -->
                <div class="table-responsive my-3">
                    <table class="table table-dark align-middle mb-0">
                        <thead class="table-secondary text-dark fs-5">
                            <tr>
                                <th class="ps-3">Producto</th>
                                <th class="text-center">Cant.</th>
                                <th class="text-end pe-3">SubTotal</th>
                            </tr>
                        </thead>
                        <tbody class="fs-5">
                            @if (pedido.Detalles != null && pedido.Detalles.Any())
                            {
                                @foreach (var detalle in pedido.Detalles)
                                {
                                    <tr>
                                        <td class="ps-3 fw-semibold">@detalle.NombreProducto</td>
                                        <td class="text-center">@detalle.Cantidad</td>
                                        <td class="text-end pe-3 fw-bold">$@detalle.SubTotal.ToString("F2")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold">Camisa</td>
                                    <td class="text-center">1</td>
                                    <td class="text-end pe-3 fw-bold">$@pedido.Total.ToString("F2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Botón Ver Factura -->
                <div class="mt-3">
                    <button class="btn btn-info text-white fw-bold px-4 py-2 fs-5" 
                            @onclick="() => VerFactura(pedido.Id)">
                        Ver Factura
                    </button>
                </div>
            </div>
        }
    }
</div>

@code {
    private List<PedidoDTO> pedidos = new();
    private bool cargando = true;

    
    private int usuarioIdActual = 1; 

    protected override async Task OnInitializedAsync()
    {
        await CargarPedidos();
    }

    private async Task CargarPedidos()
    {
        cargando = true;
        try
        {
            pedidos = await PedidoService.ObtenerMisPedidosAsync(usuarioIdActual);
        }
        catch (Exception)
        {
            pedidos = new List<PedidoDTO>();
        }
        finally
        {
            cargando = false;
        }
    }

    private void VerFactura(int pedidoId)
    {
        Navigation.NavigateTo($"/factura/{pedidoId}");
    }
}