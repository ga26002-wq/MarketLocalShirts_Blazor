@page "/pago"
@rendermode InteractiveServer
@inject CarritoService CarritoService
@inject NavigationManager Navigation
@using System.ComponentModel.DataAnnotations
@using MarketLocalShirts.DTO.CarritoDTO

<PageTitle>Pago - MarketLocalShirts</PageTitle>

<div class="pago-pagina">
    <div class="pago-encabezado">
        <h1>Pago</h1>
        <p>Total: $@totalGeneral.ToString("F2")</p>
    </div>

    <div class="pago-panel">
        <p class="pago-seccion">Entrega</p>
        <div class="mb-3">
            <label class="pago-label">Nombre</label>
            <input type="text" class="form-control pago-input @(errores.ContainsKey("Nombre") ? "border border-danger" : "")" autocomplete="off" placeholder="Nombre completo" @bind="nombre" />
            @if (errores.TryGetValue("Nombre", out var errorNombre))
            {
                <div class="text-danger fw-bold mt-1">@errorNombre</div>
            }
        </div>

        <div class="mb-3">
            <label class="pago-label">Correo</label>
            <input type="email" class="form-control pago-input @(errores.ContainsKey("Correo") ? "border border-danger" : "")" autocomplete="off" placeholder="correo@ejemplo.com" @bind="correo" />
            @if (errores.TryGetValue("Correo", out var errorCorreo))
            {
                <div class="text-danger fw-bold mt-1">@errorCorreo</div>
            }
        </div>

        <div class="mb-3">
            <label class="pago-label">Direccion</label>
            <input type="text" class="form-control pago-input @(errores.ContainsKey("Direccion") ? "border border-danger" : "")" autocomplete="off" placeholder="Dirección de entrega" @bind="direccion" />
            @if (errores.TryGetValue("Direccion", out var errorDireccion))
            {
                <div class="text-danger fw-bold mt-1">@errorDireccion</div>
            }
        </div>

        <div class="pago-tarjeta">
        <p class="pago-seccion mb-3">Tarjeta</p>

        <div class="mb-3">
            <label class="pago-label">Titular</label>
            <input type="text" class="form-control pago-input @(errores.ContainsKey("Titular") ? "border border-danger" : "")" autocomplete="off" placeholder="Nombre en la tarjeta" @bind="titularTarjeta" />
            @if (errores.TryGetValue("Titular", out var errorTitular))
            {
                <div class="text-danger fw-bold mt-1">@errorTitular</div>
            }
        </div>

        <!-- Número de Tarjeta con formato automático de 4 en 4 -->
        <div class="mb-3">
            <label class="pago-label">Numero</label>
            <input type="text" class="form-control pago-input @(errores.ContainsKey("Numero") ? "border border-danger" : "")" 
                   maxlength="19" 
                   autocomplete="off" 
                   placeholder="4444 4444 4444 4444" 
                   @bind="numeroTarjeta" 
                   @bind:event="oninput" />
            @if (errores.TryGetValue("Numero", out var errorNumero))
            {
                <div class="text-danger fw-bold mt-1">@errorNumero</div>
            }
        </div>

        <div class="row g-2">
            <div class="col-6">
                <label class="pago-label">Vence</label>
                <!-- Vencimiento con formato automático MM/AA -->
                <input type="text" class="form-control pago-input text-center @(errores.ContainsKey("Vencimiento") ? "border border-danger" : "")" 
                       maxlength="5" 
                       name="no-vence-field"
                       autocomplete="off" 
                       placeholder="MM/AA" 
                       @bind="vencimiento" 
                       @bind:event="oninput" />
                @if (errores.TryGetValue("Vencimiento", out var errorVence))
                {
                    <div class="text-danger fw-bold mt-1">@errorVence</div>
                }
            </div>
            <div class="col-6">
                <label class="pago-label">CVV</label>
                <!-- CVV limitado estrictamente a 3 dígitos -->
                <input type="password" class="form-control pago-input text-center @(errores.ContainsKey("Cvv") ? "border border-danger" : "")" 
                       maxlength="3" 
                       name="no-cvv-field"
                       autocomplete="new-password" 
                       placeholder="123" 
                       @bind="cvv" 
                       @bind:event="oninput" />
                @if (errores.TryGetValue("Cvv", out var errorCvv))
                {
                    <div class="text-danger fw-bold mt-1">@errorCvv</div>
                }
            </div>
        </div>
        </div>

        <div class="pago-acciones">
            <button class="btn btn-volver" @onclick="VolverAlCarrito">Volver</button>
            <button class="btn btn-pagar" @onclick="ProcesarPagoFinal">Pagar</button>
        </div>

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger mt-4 text-center rounded-2">
                @mensajeError
            </div>
        }
    </div>
</div>

<style>
    .pago-pagina {
        background: #000;
        min-height: calc(100vh - 60px);
        padding: 1.75rem 1rem 2.5rem;
        color: #fff;
    }

    .pago-encabezado {
        text-align: center;
        margin-bottom: 1.25rem;
    }

    .pago-encabezado h1 {
        font-size: 1.6rem;
        font-weight: 700;
        margin: 0;
    }

    .pago-encabezado p {
        margin: 0.25rem 0 0;
        color: #00a8ff;
        font-weight: 700;
    }

    .pago-panel {
        width: min(440px, 100%);
        margin: 0 auto;
        background: #1c1c1c;
        border: 1px solid #333;
        border-radius: 12px;
        padding: 1.25rem 1.25rem 1.1rem;
    }

    .pago-seccion {
        margin: 0 0 0.75rem;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #9aa0a6;
    }

    .pago-label {
        display: block;
        margin-bottom: 0.3rem;
        font-size: 0.88rem;
        font-weight: 600;
    }

    .pago-input {
        background: #2a2a2a;
        color: #fff;
        border: 1px solid #3a3a3a;
        border-radius: 8px;
        padding: 0.45rem 0.7rem;
    }

    .pago-input:focus {
        background: #2a2a2a;
        color: #fff;
        border-color: #00a8ff;
        box-shadow: none;
    }

    .pago-tarjeta {
        margin-top: 0.4rem;
        padding: 0.9rem 0.9rem 0.2rem;
        border-radius: 10px;
        background: linear-gradient(160deg, #243044 0%, #1a1f2b 55%, #161616 100%);
        border: 1px solid #31445f;
    }

    .pago-acciones {
        display: flex;
        gap: 0.6rem;
        margin-top: 1rem;
    }

    .btn-volver,
    .btn-pagar {
        flex: 1;
        border: none;
        border-radius: 8px;
        padding: 0.5rem 0.75rem;
        font-weight: 600;
    }

    .btn-volver {
        background: #2c2c2c;
        color: #fff;
    }

    .btn-pagar {
        background: #00a8ff;
        color: #fff;
    }

    .btn-pagar:hover,
    .btn-volver:hover {
        filter: brightness(1.08);
    }
</style>

@code {
    private decimal totalGeneral = 0m;
    private string nombre = string.Empty;
    private string correo = string.Empty;
    private string direccion = string.Empty;
    private string titularTarjeta = string.Empty;
    
    // Propiedad para Número de Tarjeta (Espacios automáticos)
    private string _numeroTarjeta = string.Empty;
    private string numeroTarjeta
    {
        get => _numeroTarjeta;
        set
        {
            if (_numeroTarjeta != value)
            {
                var soloNumeros = new string((value ?? "").Where(char.IsDigit).ToArray());
                if (soloNumeros.Length > 16) soloNumeros = soloNumeros.Substring(0, 16);

                var bloques = Enumerable.Range(0, (soloNumeros.Length + 3) / 4)
                    .Select(i => soloNumeros.Substring(i * 4, Math.Min(4, soloNumeros.Length - i * 4)));
                
                _numeroTarjeta = string.Join(" ", bloques);
            }
        }
    }

    // Propiedad para Vencimiento (Formato automático MM/AA)
    private string _vencimiento = string.Empty;
    private string vencimiento
    {
        get => _vencimiento;
        set
        {
            if (_vencimiento != value)
            {
                var soloNumeros = new string((value ?? "").Where(char.IsDigit).ToArray());
                if (soloNumeros.Length > 4) soloNumeros = soloNumeros.Substring(0, 4);

                if (soloNumeros.Length >= 3)
                {
                    _vencimiento = soloNumeros.Substring(0, 2) + "/" + soloNumeros.Substring(2);
                }
                else
                {
                    _vencimiento = soloNumeros;
                }
            }
        }
    }

    // Propiedad para CVV (Máximo 3 dígitos)
    private string _cvv = string.Empty;
    private string cvv
    {
        get => _cvv;
        set
        {
            if (_cvv != value)
            {
                var soloNumeros = new string((value ?? "").Where(char.IsDigit).ToArray());
                if (soloNumeros.Length > 3) soloNumeros = soloNumeros.Substring(0, 3);
                _cvv = soloNumeros;
            }
        }
    }

    private string mensajeError = string.Empty;
    private Dictionary<string, string> errores = new();

    protected override async Task OnInitializedAsync()
    {
        var items = await CarritoService.ObtenerAsync();
        if (items != null)
        {
            totalGeneral = items.Sum(x => x.SubTotal);
        }
    }

    private void VolverAlCarrito()
    {
        Navigation.NavigateTo("/carrito");
    }

    private async Task ProcesarPagoFinal()
    {
        mensajeError = string.Empty;
        var datos = new DatosPago
        {
            Nombre = nombre,
            Correo = correo,
            Direccion = direccion,
            Titular = titularTarjeta,
            Numero = new string(numeroTarjeta.Where(char.IsDigit).ToArray()),
            Vencimiento = vencimiento,
            Cvv = cvv
        };
        errores = ValidacionFormulario.Errores(datos);
        if (errores.TryGetValue("Vencimiento", out _) == false)
            ValidarVencimiento();

        if (errores.Count > 0)
        {
            mensajeError = "Revisa los campos marcados en rojo.";
            return;
        }

        try
        {
            var resultado = await CarritoService.PagarAsync();
            if (resultado.Ok)
            {
                Navigation.NavigateTo("/mis-pedidos");
            }
            else
            {
                mensajeError = resultado.Mensaje;
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error en el servidor al procesar el pago: {ex.Message}";
        }
    }

    private void ValidarVencimiento()
    {
        if (vencimiento.Length != 5 || !vencimiento.Contains('/'))
        {
            errores["Vencimiento"] = "Debes ingresar una fecha de vencimiento completa (MM/AA).";
            return;
        }

        var partes = vencimiento.Split('/');
        if (!int.TryParse(partes[0], out int mes) || !int.TryParse(partes[1], out int anioCorto) || mes < 1 || mes > 12)
        {
            errores["Vencimiento"] = "El mes de vencimiento no es válido (debe ser 01 al 12).";
            return;
        }

        int anio = 2000 + anioCorto;
        var fechaVencimiento = new DateTime(anio, mes, DateTime.DaysInMonth(anio, mes));
        if (fechaVencimiento < DateTime.Now)
            errores["Vencimiento"] = "La tarjeta ingresada está vencida.";
    }

    private sealed class DatosPago
    {
        [Required(ErrorMessage = "El nombre es obligatorio")]
        public string Nombre { get; set; } = string.Empty;

        [Required(ErrorMessage = "El correo es obligatorio")]
        [EmailAddress(ErrorMessage = "Debes escribir un correo válido, por ejemplo nombre@correo.com")]
        public string Correo { get; set; } = string.Empty;

        [Required(ErrorMessage = "La dirección es obligatoria")]
        public string Direccion { get; set; } = string.Empty;

        [Required(ErrorMessage = "El titular de la tarjeta es obligatorio")]
        public string Titular { get; set; } = string.Empty;

        [Required(ErrorMessage = "El número de tarjeta es obligatorio")]
        [RegularExpression(@"^\d{16}$", ErrorMessage = "El número de tarjeta debe tener 16 dígitos")]
        public string Numero { get; set; } = string.Empty;

        [Required(ErrorMessage = "La fecha de vencimiento es obligatoria")]
        public string Vencimiento { get; set; } = string.Empty;

        [Required(ErrorMessage = "El CVV es obligatorio")]
        [RegularExpression(@"^\d{3}$", ErrorMessage = "El CVV debe tener 3 dígitos")]
        public string Cvv { get; set; } = string.Empty;
    }
}