@page "/perfil"
@using MarketLocalShirts.DTO.UsuarioDTO
@using MarketLocalShirts.Service
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Mi Perfil - MarketLocalShirts</PageTitle>

<div class="container my-4 text-white" style="max-width: 820px;">
    <h1 class="text-center mb-4 fw-bold" style="font-size: 1.75rem;">Mi Perfil</h1>

    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-info" role="status">
                <span class="visually-hidden">Cargando perfil desde la API...</span>
            </div>
        </div>
    }
    else
    {
        <div class="row justify-content-center g-4">
            <!-- Columna Izquierda: Datos del Usuario -->
            <div class="col-md-6">
                <h2 class="fw-bold mb-3" style="font-size: 1.15rem;">Datos</h2>

                <div class="mb-3">
                    <label class="form-label fw-bold mb-1">Nombre</label>
                    <input type="text" 
                           class="form-control bg-secondary text-white border-0 py-2 @(errores.ContainsKey("Nombre") ? "border border-danger" : "")" 
                           @bind="usuario.Nombre" 
                           placeholder="Tu nombre completo" />
                    @if (errores.TryGetValue("Nombre", out var errorNombre))
                    {
                        <div class="text-danger fw-bold mt-1">@errorNombre</div>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold mb-1">Correo</label>
                    <input type="email" 
                           class="form-control bg-secondary text-white border-0 py-2 @(errores.ContainsKey("Correo") ? "border border-danger" : "")" 
                           @bind="usuario.Correo" 
                           placeholder="correo@ejemplo.com" />
                    @if (errores.TryGetValue("Correo", out var errorCorreo))
                    {
                        <div class="text-danger fw-bold mt-1">@errorCorreo</div>
                    }
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold mb-1">Teléfono</label>
                    <input type="text" 
                           class="form-control bg-secondary text-white border-0 py-2 @(errores.ContainsKey("Telefono") ? "border border-danger" : "")" 
                           @bind="usuario.Telefono" 
                           placeholder="0000-0000" />
                    @if (errores.TryGetValue("Telefono", out var errorTelefono))
                    {
                        <div class="text-danger fw-bold mt-1">@errorTelefono</div>
                    }
                </div>
            </div>

            <!-- Columna Derecha: Contraseña y Cerrar Sesión -->
            <div class="col-md-5 d-flex flex-column justify-content-start">
                <div class="mb-4">
                    <h2 class="fw-bold mb-2" style="font-size: 1.15rem;">Contraseña</h2>
                    <p class="mb-3 text-white-50">
                        Te enviaremos un enlace a tu correo
                    </p>
                    <button class="btn btn-info text-white fw-semibold px-3 py-2 w-100"
                            disabled="@enviandoEnlace"
                            @onclick="EnviarEnlaceContrasena">
                        @(enviandoEnlace ? "Enviando..." : "Enviar enlace")
                    </button>
                    @if (!string.IsNullOrEmpty(mensajeEnlace))
                    {
                        <div class="mt-3 p-3 rounded-3" role="status" style="background-color: @(enlaceEnviado ? "#123524" : "#3a1616"); border: 1px solid @(enlaceEnviado ? "#1f7a4d" : "#a33");">
                            <div class="fw-bold">
                                <i class="bi @(enlaceEnviado ? "bi-check-circle-fill text-success" : "bi-exclamation-circle-fill text-danger") me-2"></i>
                                @(enlaceEnviado ? "Enlace enviado" : "No se pudo enviar")
                            </div>
                            <div class="mt-1 text-white-50">@mensajeEnlace</div>
                        </div>
                    }
                </div>

                <div class="mt-2">
                    <button class="btn btn-danger text-white fw-semibold px-3 py-2 w-100" 
                            @onclick="CerrarSesion">
                        Cerrar Sesión
                    </button>
                </div>
            </div>
        </div>

        <!-- Botón Guardar Centrado -->
        <div class="row mt-4">
            <div class="col-12 text-center">
                <button class="btn btn-info text-white fw-semibold px-4 py-2" 
                        @onclick="GuardarCambios">
                    Guardar
                </button>
            </div>
        </div>

        <!-- Mensaje de Estado -->
        @if (!string.IsNullOrEmpty(mensaje))
        {
            <div class="row mt-4">
                <div class="col-12 text-center">
                    <div class="alert alert-info d-inline-block px-3 py-2" role="alert">
                        @mensaje
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private PerfilUsuarioDTO usuario = new();
    private bool cargando = true;
    private bool enviandoEnlace;
    private bool enlaceEnviado;
    private string mensaje = string.Empty;
    private string mensajeEnlace = string.Empty;
    private Dictionary<string, string> errores = new();

    protected override void OnInitialized()
    {
        if (AuthService.PerfilEnMemoria is not { } perfil)
            return;

        usuario = perfil;
        cargando = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !cargando)
            return;

        await CargarPerfilDesdeApi();
        StateHasChanged();
    }

    private async Task CargarPerfilDesdeApi()
    {
        cargando = true;
        try
        {
            var perfilRemoto = await AuthService.ObtenerPerfilAsync();
            if (perfilRemoto != null)
                usuario = perfilRemoto;
            else
                mensaje = "No se pudo cargar el perfil. Inicia sesión como cliente.";
        }
        catch (Exception ex)
        {
            mensaje = "Error al conectar con la API: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task GuardarCambios()
    {
        errores = ValidacionFormulario.Errores(usuario);
        if (errores.Count > 0)
        {
            mensaje = "Revisa los campos marcados en rojo.";
            return;
        }

        var resultado = await AuthService.ActualizarPerfilAsync(usuario);
        mensaje = resultado.Ok ? "Perfil actualizado." : resultado.Mensaje;
    }

    private async Task EnviarEnlaceContrasena()
    {
        mensajeEnlace = string.Empty;
        enlaceEnviado = false;
        if (string.IsNullOrWhiteSpace(usuario.Correo))
        {
            mensajeEnlace = "Escribe el correo antes de pedir el enlace.";
            return;
        }

        enviandoEnlace = true;
        try
        {
            var resultado = await AuthService.SolicitarRecuperacionAsync(usuario.Correo);
            enlaceEnviado = resultado.Ok;
            mensajeEnlace = resultado.Ok
                ? $"Revisa {usuario.Correo}. El enlace para cambiar tu contraseña es válido por 30 minutos."
                : resultado.Mensaje;
        }
        finally
        {
            enviandoEnlace = false;
        }
    }

    private async Task CerrarSesion()
    {
        await AuthService.Logout();
        Navigation.NavigateTo("/login");
    }
}