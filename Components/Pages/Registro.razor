@page "/registro"
@rendermode InteractiveServer
@inject AuthService AuthService
@inject NavigationManager Navigation
@using System.ComponentModel.DataAnnotations
@using System.Text.Json.Serialization

<div class="register-wrapper d-flex align-items-center justify-content-center bg-black text-white px-3 py-4" style="min-height: calc(100vh - 60px);">
    <div class="card text-white p-4 shadow-lg border-0 rounded-3" style="max-width: 420px; width: 100%; background-color: #2b2b2b !important;">
        <div class="text-center mb-3">
            <h2 class="fw-bold fs-4 mb-1">Crear Cuenta</h2>
            <p class="fs-6 text-light mb-0">Completa tus datos para registrarte.</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger py-2 text-center rounded-3 mb-3 small">@errorMessage</div>
        }
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success py-2 text-center rounded-3 mb-3 small">@successMessage</div>
        }

        <div class="form-group mb-2">
            <label class="form-label fw-bold mb-1 small">Nombre Completo</label>
            <input type="text" class="form-control bg-light text-dark rounded-2 @(errores.ContainsKey("Nombre") ? "border border-danger" : "border-0")" @bind="registerModel.Nombre" placeholder="Tu nombre" />
            @if (errores.TryGetValue("Nombre", out var errorNombre))
            {
                <div class="text-danger small fw-bold mt-1">@errorNombre</div>
            }
        </div>

        <div class="form-group mb-2">
            <label class="form-label fw-bold mb-1 small">Correo Electrónico</label>
            <input type="email" class="form-control bg-light text-dark rounded-2 @(errores.ContainsKey("Email") ? "border border-danger" : "border-0")" @bind="registerModel.Email" placeholder="tucorreo@email.com" />
            @if (errores.TryGetValue("Email", out var errorCorreo))
            {
                <div class="text-danger small fw-bold mt-1">@errorCorreo</div>
            }
        </div>

        <div class="form-group mb-2">
            <label class="form-label fw-bold mb-1 small">Contraseña</label>
            <input type="password" class="form-control bg-light text-dark rounded-2 @(errores.ContainsKey("Clave") ? "border border-danger" : "border-0")" @bind="registerModel.Clave" placeholder="••••••••" />
            @if (errores.TryGetValue("Clave", out var errorClave))
            {
                <div class="text-danger small fw-bold mt-1">@errorClave</div>
            }
        </div>

        <div class="form-group mb-2">
            <label class="form-label fw-bold mb-1 small">Confirmar Contraseña</label>
            <input type="password" class="form-control bg-light text-dark rounded-2 @(errores.ContainsKey("Confirmar") ? "border border-danger" : "border-0")" @bind="confirmarClave" placeholder="••••••••" />
            @if (errores.TryGetValue("Confirmar", out var errorConfirmar))
            {
                <div class="text-danger small fw-bold mt-1">@errorConfirmar</div>
            }
        </div>

        <div class="form-group mb-3">
            <label class="form-label fw-bold mb-1 small">Teléfono</label>
            <input type="tel" class="form-control bg-light text-dark rounded-2 @(errores.ContainsKey("Telefono") ? "border border-danger" : "border-0")" @bind="registerModel.Telefono" placeholder="7000-0000" />
            @if (errores.TryGetValue("Telefono", out var errorTelefono))
            {
                <div class="text-danger small fw-bold mt-1">@errorTelefono</div>
            }
        </div>

        <button type="button" class="btn btn-info w-100 fw-bold text-white mb-3 rounded-2" style="background-color: #00a8ff; border: none; padding: 0.6rem;" @onclick="HandleRegister">
            Crear Cuenta
        </button>

        <div class="text-center small">
            <p class="mb-0 text-light">
                ¿Ya tienes una cuenta? 
                <a href="/login" class="text-decoration-none fw-bold" style="color: #00a8ff;">Inicia Sesión</a>
            </p>
        </div>
    </div>
</div>

@code {
    private RegisterModel registerModel = new();
    private string confirmarClave = string.Empty;
    private string? errorMessage;
    private string? successMessage;
    private Dictionary<string, string> errores = new();

    private async Task HandleRegister()
    {
        errorMessage = null;
        successMessage = null;
        errores = ValidacionFormulario.Errores(registerModel);
        if (registerModel.Clave != confirmarClave)
            errores["Confirmar"] = "Las contraseñas no coinciden.";

        if (errores.Count > 0)
            return;

        try
        {
            // URL corregida a /api/auth/registro (como en IntelliJ)
            var resultado = await AuthService.RegistrarAsync(
                registerModel.Nombre,
                registerModel.Email,
                registerModel.Clave,
                registerModel.Telefono);

            if (resultado.Ok)
            {
                successMessage = "Cuenta creada. Redirigiendo al login...";
                await Task.Delay(1500);
                Navigation.NavigateTo("/login");
            }
            else
            {
                errorMessage = resultado.Mensaje;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Excepción: {ex.Message}";
        }
    }

    public class RegisterModel
    {
        [Required(ErrorMessage = "El nombre es obligatorio")]
        [StringLength(100, ErrorMessage = "El nombre no debe superar 100 caracteres")]
        [JsonPropertyName("nombre")]
        public string Nombre { get; set; } = string.Empty;

        [Required(ErrorMessage = "El correo es obligatorio")]
        [EmailAddress(ErrorMessage = "Debes escribir un correo válido, por ejemplo nombre@correo.com")]
        [JsonPropertyName("login")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "La clave es obligatoria")]
        [MinLength(6, ErrorMessage = "La clave debe tener al menos 6 caracteres")]
        [JsonPropertyName("clave")]
        public string Clave { get; set; } = string.Empty;

        [StringLength(20, ErrorMessage = "El telefono no debe superar 20 caracteres")]
        [JsonPropertyName("telefono")]
        public string Telefono { get; set; } = string.Empty;
    }
}