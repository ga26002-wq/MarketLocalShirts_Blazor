@page "/registro"
@rendermode InteractiveServer
@inject HttpClient Http
@inject NavigationManager Navigation
@using System.Text.Json.Serialization

<div class="register-wrapper d-flex align-items-center justify-content-center bg-black text-white px-3 py-4" style="min-height: calc(100vh - 60px);">
    <div class="card text-white p-4 shadow-lg border-0 rounded-3" style="max-width: 420px; width: 100%; background-color: #2b2b2b !important;">
        <div class="text-center mb-3">
            <h2 class="fw-bold fs-4 mb-1">Crear Cuenta</h2>
            <p class="fs-6 text-light mb-0">Completa tus datos para registrarte.</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger py-2 text-center rounded-3 mb-3 small">@errorMessage</div>
        }
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success py-2 text-center rounded-3 mb-3 small">@successMessage</div>
        }

        <div class="form-group mb-2">
            <label class="form-label fw-bold mb-1 small">Nombre Completo</label>
            <input type="text" class="form-control bg-light text-dark border-0 rounded-2" @bind="registerModel.Nombre" placeholder="Tu nombre" />
        </div>

        <div class="form-group mb-2">
            <label class="form-label fw-bold mb-1 small">Correo Electrónico</label>
            <input type="email" class="form-control bg-light text-dark border-0 rounded-2" @bind="registerModel.Email" placeholder="tucorreo@email.com" />
        </div>

        <div class="form-group mb-2">
            <label class="form-label fw-bold mb-1 small">Contraseña</label>
            <input type="password" class="form-control bg-light text-dark border-0 rounded-2" @bind="registerModel.Clave" placeholder="••••••••" />
        </div>

        <div class="form-group mb-2">
            <label class="form-label fw-bold mb-1 small">Confirmar Contraseña</label>
            <input type="password" class="form-control bg-light text-dark border-0 rounded-2" @bind="confirmarClave" placeholder="••••••••" />
        </div>

        <div class="form-group mb-3">
            <label class="form-label fw-bold mb-1 small">Teléfono</label>
            <input type="tel" class="form-control bg-light text-dark border-0 rounded-2" @bind="registerModel.Telefono" placeholder="7000-0000" />
        </div>

        <button type="button" class="btn btn-info w-100 fw-bold text-white mb-3 rounded-2" style="background-color: #00a8ff; border: none; padding: 0.6rem;" @onclick="HandleRegister">
            Crear Cuenta
        </button>

        <div class="text-center small">
            <p class="mb-0 text-light">
                ¿Ya tienes una cuenta? 
                <a href="/login" class="text-decoration-none fw-bold" style="color: #00a8ff;">Inicia Sesión</a>
            </p>
        </div>
    </div>
</div>

@code {
    private RegisterModel registerModel = new();
    private string confirmarClave = string.Empty;
    private string? errorMessage;
    private string? successMessage;

    private async Task HandleRegister()
    {
        errorMessage = null;
        successMessage = null;

        if (registerModel.Clave != confirmarClave)
        {
            errorMessage = "Las contraseñas no coinciden.";
            return;
        }

        try
        {
            // URL corregida a /api/auth/registro (como en IntelliJ)
            var response = await Http.PostAsJsonAsync("http://localhost:8080/api/auth/registro", registerModel);

            if (response.IsSuccessStatusCode)
            {
                successMessage = "¡Cuenta creada exitosamente! Redirigiendo al login...";
                await Task.Delay(2000);
                Navigation.NavigateTo("/login");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error {(int)response.StatusCode}: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Excepción: {ex.Message}";
        }
    }

  public class RegisterModel
{
    [JsonPropertyName("nombre")]
    public string Nombre { get; set; } = string.Empty;

    [JsonPropertyName("login")] // <-- Aquí cambiamos "email" por "login"
    public string Email { get; set; } = string.Empty;

    [JsonPropertyName("clave")]
    public string Clave { get; set; } = string.Empty;

    [JsonPropertyName("telefono")]
    public string Telefono { get; set; } = string.Empty;
}
}