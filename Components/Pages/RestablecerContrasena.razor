@page "/RestablecerContrasena"
@rendermode InteractiveServer
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Restablecer contraseña - MarketLocalShirts</PageTitle>

<div class="d-flex align-items-center justify-content-center bg-black text-white px-3 py-5" style="min-height: calc(100vh - 60px);">
    <div class="card text-white p-4 shadow-lg border-0 rounded-3" style="max-width: 420px; width: 100%; background-color: #2b2b2b !important;">
        <h2 class="fw-bold fs-4 mb-3 text-center">Nueva contraseña</h2>

        @if (!string.IsNullOrEmpty(mensaje))
        {
            <div class="alert @(exito ? "alert-success" : "alert-danger") py-2 text-center small">@mensaje</div>
        }

        <div class="mb-4">
            <label class="form-label fw-bold small mb-2">Nueva contraseña</label>
            <div class="campo-clave">
                <input type="@(verNueva ? "text" : "password")" class="form-control bg-light text-dark @(errores.ContainsKey("NuevaClave") ? "border border-danger" : "border-0")" @bind="nuevaClave" @bind:event="oninput" />
                <button type="button" class="ojo-clave" @onclick="() => verNueva = !verNueva" title="@(verNueva ? "Ocultar" : "Ver")">
                    <i class="bi @(verNueva ? "bi-eye-slash" : "bi-eye")"></i>
                </button>
            </div>
            @if (errores.TryGetValue("NuevaClave", out var errorClave))
            {
                <div class="text-danger small fw-bold mt-1">@errorClave</div>
            }
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold small mb-2">Confirmar</label>
            <div class="campo-clave">
                <input type="@(verConfirmar ? "text" : "password")" class="form-control bg-light text-dark @(errores.ContainsKey("Confirmar") ? "border border-danger" : "border-0")" @bind="confirmar" @bind:event="oninput" />
                <button type="button" class="ojo-clave" @onclick="() => verConfirmar = !verConfirmar" title="@(verConfirmar ? "Ocultar" : "Ver")">
                    <i class="bi @(verConfirmar ? "bi-eye-slash" : "bi-eye")"></i>
                </button>
            </div>
            @if (errores.TryGetValue("Confirmar", out var errorConfirmar))
            {
                <div class="text-danger small fw-bold mt-1">@errorConfirmar</div>
            }
        </div>

        <button class="btn w-100 fw-bold text-white rounded-2 py-2" style="background-color: #00a8ff; border: none;" @onclick="Guardar">
            Guardar contraseña
        </button>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private string nuevaClave = string.Empty;
    private string confirmar = string.Empty;
    private bool verNueva;
    private bool verConfirmar;
    private string mensaje = string.Empty;
    private bool exito;
    private Dictionary<string, string> errores = new();

    private async Task Guardar()
    {
        mensaje = string.Empty;
        exito = false;
        var solicitud = new RestablecerClaveDTO
        {
            Token = Token ?? string.Empty,
            NuevaClave = nuevaClave
        };
        errores = ValidacionFormulario.Errores(solicitud);
        errores.Remove("Token");
        if (string.IsNullOrWhiteSpace(Token))
            mensaje = "El enlace no trae el token de recuperación.";
        if (string.IsNullOrWhiteSpace(nuevaClave))
            errores["NuevaClave"] = "La nueva contraseña es obligatoria";
        else if (nuevaClave.Length < 6)
            errores["NuevaClave"] = "La nueva contraseña debe tener al menos 6 caracteres";
        if (nuevaClave != confirmar)
            errores["Confirmar"] = "Las contraseñas no coinciden.";
        if (!string.IsNullOrEmpty(mensaje) || errores.Count > 0)
            return;

        var resultado = await AuthService.RestablecerClaveAsync(solicitud.Token, solicitud.NuevaClave);
        exito = resultado.Ok;
        mensaje = resultado.Mensaje;
        if (resultado.Ok)
        {
            await Task.Delay(1500);
            Navigation.NavigateTo("/login");
        }
    }
}
